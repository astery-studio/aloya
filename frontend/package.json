{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "expo": "~57.0.14",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4"
  },

  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand"
  },

  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "components/**/*.{js,jsx}",
      "features/**/*.{js,jsx}",
      "hooks/**/*.{js,jsx}",
      "layouts/**/*.{js,jsx}",
      "services/**/*.{js,jsx}",
      "utils/**/*.{js,jsx}",
      "!**/*.style.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  },

  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "jest-expo": "^57.0.4",
    "react-test-renderer": "^19.2.3"
  }
}
