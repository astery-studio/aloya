{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "preview:hu013": "set \"EXPO_PUBLIC_PREVIEW_HU013=true\" && expo start --go --clear",
    "android": "expo start --go --android",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "format:check:ci": "prettier --check app.config.js app.config.test.cjs eas.json eslint.config.js package.json",
    "config:validate": "node --test app.config.test.cjs",
    "ios": "expo start --go --ios",
    "lint": "expo lint src tests --max-warnings=0",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint:support-network": "expo lint src/features/support-network src/shared/components/forms/SwitchField tests/features/support-network"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/app.config.test.cjs$"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|phosphor-react-native))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "components/**/*.{js,jsx}",
      "utils/**/*.{js,jsx}",
      "!**/*.style.js",
      "!**/*.styles.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^17.12.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.3.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
