generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// ENUMS
// ============================================================

enum Papel {
  principal
  contato_apoio
  principal_e_contato_apoio
}

enum StatusConta {
  ativa
  pendente_consentimento_parental
  pendente_confirmacao_email
  suspensa
  desativada
}

enum TemaVisual {
  claro
  escuro
  automatico
}

enum StatusConfirmacaoEmail {
  pendente
  usado
  expirado
  revogado
}

enum StatusConsentimento {
  liberado
  pendente
  expirado
  revogado
}

enum StatusLinkRecuperacao {
  pendente
  usado
  expirado
  revogado
}

enum StatusSincronizacao {
  sincronizado
  pendente
  falha
}

enum ClassificacaoCiclo {
  normal
  atipico
  irregular
}

enum NivelConfianca {
  baixa
  media
  alta
}

enum FaseCiclo {
  menstrual
  folicular
  ovulatoria
  lutea
}

enum TipoValorDiario {
  opcoes
  decimal_escalado
  duracao_minutos
  texto
}

enum EstadoAnaliseTermica {
  elevacao_detectada
  inconclusivo
  medicao_nao_utilizada
  nenhuma_elevacao_identificada
  dados_insuficientes
}

enum EstadoUsoMedicaoTermica {
  elegivel
  nao_utilizada_interferencia
}

enum TipoAnticoncepcional {
  pilula
  injetavel
  adesivo
  anel_vaginal
  diu_hormonal
}

enum FrequenciaUso {
  uso_21_dias_pausa_7_dias
  uso_24_dias_pausa_4_dias
  uso_12_semanas_pausa_1_semana
  uso_continuo
  aplicacao_mensal
  aplicacao_bimestral
  aplicacao_trimestral
  uso_21_dias
  uso_28_dias
  uso_3_semanas_pausa_1_semana
}

enum NivelIntensidadeAlerta {
  leve
  moderado
  critico
}

enum StatusUso {
  confirmado
  pendente
  nao_confirmado
}

enum StatusVinculoRedeApoio {
  pendente
  ativo
  recusado
  revogado
}

enum RemetenteMensagem {
  usuario
  suporte
}

enum StatusMensagem {
  enviando
  enviada
  lida
  falha
}

enum TipoOrigemNotificacao {
  proximidade_ciclo
  mudanca_fase
  lembrete_diario
  anticoncepcional
  resposta_suporte
  rede_apoio
}

enum StatusEnvioNotificacao {
  agendada
  enviada
  cancelada
  falha
}

// ============================================================
// USUÁRIO E AUTENTICAÇÃO
// ============================================================

model Usuario {
  id                Int         @id @default(autoincrement())
  nome              String
  dataNascimento    DateTime    @map("data_nascimento")
  email             String      @unique
  emailConfirmadoEm DateTime?   @map("email_confirmado_em")
  senhaHash         String      @map("senha_hash")
  genero            String?
  papel             Papel
  statusConta       StatusConta @default(pendente_confirmacao_email) @map("status_conta")

  duracaoCicloInformada       Int? @map("duracao_ciclo_informada")
  duracaoMenstruacaoInformada Int? @map("duracao_menstruacao_informada")
  duracaoLuteaInformada       Int? @default(14) @map("duracao_lutea_informada")

  temaVisual TemaVisual @default(automatico) @map("tema_visual")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  confirmacoesEmail           ConfirmacaoEmail[]
  sessoes                     Sessao[]
  recuperacoesSenha           RecuperacaoSenha[]
  consentimentoParental       ConsentimentoParental?
  registrosCiclo              RegistroCiclo[]
  analisesTermicas            AnaliseTermicaCiclo[]
  sincronizacoesMenstruais    SincronizacaoMenstrual[]
  previsao                    Previsao?
  registrosDiario             RegistroDiario[]
  configuracaoDiario          ConfiguracaoDiario?
  preferenciasMacroDiario     PreferenciaMacrocategoriaDiario[]
  preferenciasCategoriaDiario PreferenciaCategoriaDiario[]
  anticoncepcionais           Anticoncepcional[]
  categoriasPermissao         CategoriaPermissao[]
  preferenciaNotificacao      PreferenciaNotificacao?
  notificacoes                Notificacao[]
  conversaSuporte             Conversa?

  vinculosComoTitular VinculoRedeApoio[] @relation("VinculoTitular")
  vinculosComoContato VinculoRedeApoio[] @relation("VinculoContato")

  @@map("usuarios")
}

model ConfirmacaoEmail {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tokenHash         String                 @unique @map("token_hash")
  statusConfirmacao StatusConfirmacaoEmail @default(pendente) @map("status_confirmacao")
  validadeToken     DateTime               @map("validade_token")
  usadoEm           DateTime?              @map("usado_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([usuarioId, statusConfirmacao])
  @@map("confirmacoes_email")
}

model ConsentimentoParental {
  id             Int     @id @default(autoincrement())
  titularMenorId Int     @unique @map("titular_menor_id")
  titularMenor   Usuario @relation(fields: [titularMenorId], references: [id], onDelete: Cascade)

  emailResponsavelLegal String              @map("email_responsavel_legal")
  tokenConfirmacaoHash  String              @unique @map("token_confirmacao_hash")
  statusConsentimento   StatusConsentimento @default(pendente) @map("status_consentimento")
  validadeLink          DateTime            @map("validade_link")
  respondidoEm          DateTime?           @map("respondido_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([emailResponsavelLegal])
  @@map("consentimentos_parentais")
}

model Sessao {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tokenSessaoHash String    @unique @map("token_sessao_hash")
  dispositivo     String?
  validadeSessao  DateTime  @map("validade_sessao")
  revogadaEm      DateTime? @map("revogada_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([usuarioId])
  @@index([validadeSessao])
  @@map("sessoes")
}

model RecuperacaoSenha {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tokenRecuperacaoHash String                @unique @map("token_recuperacao_hash")
  validadeToken        DateTime              @map("validade_token")
  statusLink           StatusLinkRecuperacao @default(pendente) @map("status_link")
  usadoEm              DateTime?             @map("usado_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([usuarioId, statusLink])
  @@map("recuperacoes_senha")
}

// ============================================================
// CICLO E PREVISÃO
// ============================================================

model RegistroCiclo {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  dataInicio DateTime  @map("data_inicio")
  dataFim    DateTime? @map("data_fim")

  duracaoMenstruacao Int? @map("duracao_menstruacao")
  duracaoCiclo       Int? @map("duracao_ciclo")

  classificacao  ClassificacaoCiclo @default(normal)
  ehCicloInicial Boolean            @default(false) @map("eh_ciclo_inicial")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  diasMenstruacao   DiaMenstruacao[]
  previsoesBaseadas Previsao[]            @relation("PrevisaoBaseadaNoCiclo")
  analisesTermicas  AnaliseTermicaCiclo[]

  @@unique([usuarioId, dataInicio])
  @@map("registros_ciclo")
}

model SincronizacaoMenstrual {
  id          Int      @id @default(autoincrement())
  usuarioId   Int      @map("usuario_id")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  chave       String
  solicitacao Json
  resultado   Json
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@unique([usuarioId, chave])
  @@map("sincronizacoes_menstruais")
}

model DiaMenstruacao {
  id              Int           @id @default(autoincrement())
  registroCicloId Int           @map("registro_ciclo_id")
  registroCiclo   RegistroCiclo @relation(fields: [registroCicloId], references: [id], onDelete: Cascade)

  data                DateTime
  statusSincronizacao StatusSincronizacao @default(sincronizado) @map("status_sincronizacao")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@unique([registroCicloId, data])
  @@map("dias_menstruacao")
}

model Previsao {
  id Int @id @default(autoincrement())

  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  registroCicloBaseId Int           @map("registro_ciclo_base_id")
  registroCicloBase   RegistroCiclo @relation("PrevisaoBaseadaNoCiclo", fields: [registroCicloBaseId], references: [id], onDelete: Cascade)

  dataGeracao DateTime @default(now()) @map("data_geracao")

  duracaoCicloPrevista    Int @map("duracao_ciclo_prevista")
  duracaoLuteaUsada       Int @map("duracao_lutea_usada")
  duracaoMenstruacaoUsada Int @map("duracao_menstruacao_usada")

  fimFaseMenstrual     DateTime @map("fim_fase_menstrual")
  inicioFaseFolicular  DateTime @map("inicio_fase_folicular")
  fimFaseFolicular     DateTime @map("fim_fase_folicular")
  dataEstimadaOvulacao DateTime @map("data_estimada_ovulacao")
  inicioFaseLutea      DateTime @map("inicio_fase_lutea")
  dataFimCicloPrevisto DateTime @map("data_fim_ciclo_previsto")

  inicioJanelaFertil DateTime @map("inicio_janela_fertil")
  fimJanelaFertil    DateTime @map("fim_janela_fertil")

  nivelConfianca NivelConfianca @map("nivel_confianca")
  cicloAtipico   Boolean        @default(false) @map("ciclo_atipico")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([registroCicloBaseId])
  @@map("previsoes")
}

// ============================================================
// DIÁRIO
// ============================================================

model MacrocategoriaDiario {
  id           String  @id
  nome         String
  nomeCompacto String? @map("nome_compacto")
  ordem        Int     @unique
  sensivel     Boolean @default(false)

  categorias   CategoriaDiario[]
  preferencias PreferenciaMacrocategoriaDiario[]

  @@map("macrocategorias_diario")
}

model CategoriaDiario {
  id               String               @id
  macrocategoriaId String               @map("macrocategoria_id")
  macrocategoria   MacrocategoriaDiario @relation(fields: [macrocategoriaId], references: [id], onDelete: Restrict)
  nome             String
  ordem            Int
  tipoValor        TipoValorDiario      @default(opcoes) @map("tipo_valor")
  sensivel         Boolean              @default(false)

  opcoes       OpcaoDiario[]
  preferencias PreferenciaCategoriaDiario[]
  registros    RegistroDiarioCategoria[]

  @@unique([macrocategoriaId, ordem])
  @@index([macrocategoriaId])
  @@map("categorias_diario")
}

model OpcaoDiario {
  id          String          @id
  categoriaId String          @map("categoria_id")
  categoria   CategoriaDiario @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  grupo       String?
  nome        String
  ordem       Int

  registros RegistroDiarioOpcao[]

  @@unique([categoriaId, ordem])
  @@index([categoriaId])
  @@map("opcoes_diario")
}

model ConfiguracaoDiario {
  usuarioId Int     @id @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  versao    Int     @default(0)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes_diario")
}

model PreferenciaMacrocategoriaDiario {
  usuarioId        Int                  @map("usuario_id")
  usuario          Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  macrocategoriaId String               @map("macrocategoria_id")
  macrocategoria   MacrocategoriaDiario @relation(fields: [macrocategoriaId], references: [id], onDelete: Restrict)
  ativa            Boolean              @default(true)
  atualizadoEm     DateTime             @updatedAt @map("atualizado_em")

  @@id([usuarioId, macrocategoriaId])
  @@index([macrocategoriaId])
  @@map("preferencias_macrocategorias_diario")
}

model PreferenciaCategoriaDiario {
  usuarioId   Int             @map("usuario_id")
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoriaId String          @map("categoria_id")
  categoria   CategoriaDiario @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  ativa       Boolean         @default(true)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  @@id([usuarioId, categoriaId])
  @@index([categoriaId])
  @@map("preferencias_categorias_diario")
}

model RegistroDiario {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  dataRegistro DateTime @map("data_registro")

  // SQLite não possui arrays nativos. O validator deve garantir
  // que cada campo contenha somente um array de strings.
  sintomasFisicos         Json @default("[]") @map("sintomas_fisicos")
  sintomasEmocionais      Json @default("[]") @map("sintomas_emocionais")
  sintomasComportamentais Json @default("[]") @map("sintomas_comportamentais")

  anotacaoLivre            String?  @map("anotacao_livre")
  temperaturaBasalCorporal Decimal? @map("temperatura_basal_corporal")

  ocorrenciaRelacaoSexual Boolean? @map("ocorrencia_relacao_sexual")
  usoMetodoProtecao       Boolean? @map("uso_metodo_protecao")

  // Snapshot histórico: não deve ser recalculado quando a previsão mudar.
  faseCicloAssociada         FaseCiclo? @map("fase_ciclo_associada")
  possivelOvulacaoConfirmada Boolean    @default(false) @map("possivel_ovulacao_confirmada")
  versao                     Int        @default(0)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  categorias RegistroDiarioCategoria[]

  @@unique([usuarioId, dataRegistro])
  @@index([usuarioId, dataRegistro, id])
  @@map("registros_diario")
}

model RegistroDiarioCategoria {
  id          Int             @id @default(autoincrement())
  registroId  Int             @map("registro_id")
  registro    RegistroDiario  @relation(fields: [registroId], references: [id], onDelete: Cascade)
  categoriaId String          @map("categoria_id")
  categoria   CategoriaDiario @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  macrocategoriaNome  String  @map("macrocategoria_nome")
  categoriaNome       String  @map("categoria_nome")
  valorEscalado       Int?    @map("valor_escalado")
  casasDecimais       Int?    @map("casas_decimais")
  valorDuracaoMinutos Int?    @map("valor_duracao_minutos")
  valorTexto          String? @map("valor_texto")

  opcoes             RegistroDiarioOpcao[]
  medicaoTemperatura MedicaoTemperaturaBasal?

  @@unique([registroId, categoriaId])
  @@index([categoriaId, registroId])
  @@map("registros_diario_categorias")
}

model RegistroDiarioOpcao {
  id                  Int                     @id @default(autoincrement())
  registroCategoriaId Int                     @map("registro_categoria_id")
  registroCategoria   RegistroDiarioCategoria @relation(fields: [registroCategoriaId], references: [id], onDelete: Cascade)
  opcaoId             String                  @map("opcao_id")
  opcao               OpcaoDiario             @relation(fields: [opcaoId], references: [id], onDelete: Restrict)
  grupo               String?
  opcaoNome           String                  @map("opcao_nome")

  @@unique([registroCategoriaId, opcaoId])
  @@index([opcaoId])
  @@map("registros_diario_opcoes")
}

model MedicaoTemperaturaBasal {
  registroCategoriaId Int                     @id @map("registro_categoria_id")
  registroCategoria   RegistroDiarioCategoria @relation(fields: [registroCategoriaId], references: [id], onDelete: Cascade)
  valorOriginal       String                  @default("") @map("valor_original")
  unidade             String                  @default("celsius")
  precisaoCasas       Int                     @default(1) @map("precisao_casas")
  perturbada          Boolean                 @default(false)
  motivoPerturbacao   String?                 @map("motivo_perturbacao")
  estadoUtilizacao    EstadoUsoMedicaoTermica @default(elegivel) @map("estado_utilizacao")
  criadoEm            DateTime                @default(now()) @map("criado_em")
  atualizadoEm        DateTime                @updatedAt @map("atualizado_em")

  @@map("medicoes_temperatura_basal")
}

model AnaliseTermicaCiclo {
  id                Int                  @id @default(autoincrement())
  usuarioId         Int                  @map("usuario_id")
  usuario           Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  registroCicloId   Int                  @map("registro_ciclo_id")
  registroCiclo     RegistroCiclo        @relation(fields: [registroCicloId], references: [id], onDelete: Cascade)
  algoritmo         String
  versaoAlgoritmo   String               @map("versao_algoritmo")
  variante          String
  disponibilidade   String
  estado            EstadoAnaliseTermica
  provisorio        Boolean              @default(true)
  janelasAvaliaveis Int                  @default(0) @map("janelas_avaliaveis")
  configuracao      Json
  sequencias        Json
  evidenciaAplicada Boolean              @default(false) @map("evidencia_aplicada")
  avaliadoAte       DateTime?            @map("avaliado_ate")
  criadoEm          DateTime             @default(now()) @map("criado_em")
  atualizadoEm      DateTime             @updatedAt @map("atualizado_em")

  @@unique([registroCicloId, versaoAlgoritmo, variante, disponibilidade])
  @@index([usuarioId, registroCicloId])
  @@map("analises_termicas_ciclo")
}

// ============================================================
// ANTICONCEPCIONAIS
// ============================================================

model Anticoncepcional {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome String
  tipo TipoAnticoncepcional

  // O validator deve garantir um array de horários no formato HH:mm.
  horariosProgramados Json @default("[]") @map("horarios_programados")

  frequencia             FrequenciaUso?
  dataInicioUso          DateTime?              @map("data_inicio_uso")
  periodosPausa          Json                   @default("[]") @map("periodos_pausa")
  dataValidade           DateTime?              @map("data_validade")
  nivelIntensidadeAlerta NivelIntensidadeAlerta @default(critico) @map("nivel_intensidade_alerta")

  // A remoção lógica preserva o histórico de usos já registrados.
  ativo      Boolean   @default(true)
  removidoEm DateTime? @map("removido_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usos UsoAnticoncepcional[]

  @@index([usuarioId, ativo])
  @@map("anticoncepcionais")
}

model UsoAnticoncepcional {
  id                 Int              @id @default(autoincrement())
  anticoncepcionalId Int              @map("anticoncepcional_id")
  anticoncepcional   Anticoncepcional @relation(fields: [anticoncepcionalId], references: [id], onDelete: Cascade)

  dataUsoProgramado DateTime @map("data_uso_programado")

  // O validator deve garantir rigorosamente o formato HH:mm.
  horarioProgramado      String    @map("horario_programado")
  horarioRealConfirmacao DateTime? @map("horario_real_confirmacao")

  statusUso            StatusUso @default(pendente) @map("status_uso")
  confirmacaoForaPrazo Boolean   @default(false) @map("confirmacao_fora_prazo")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([anticoncepcionalId, dataUsoProgramado, horarioProgramado])
  @@map("usos_anticoncepcional")
}

// ============================================================
// REDE DE APOIO
// ============================================================

model CategoriaPermissao {
  id        Int     @id @default(autoincrement())
  titularId Int     @map("titular_id")
  titular   Usuario @relation(fields: [titularId], references: [id], onDelete: Cascade)

  nome            String
  nomeNormalizado String @map("nome_normalizado")

  // Armazena somente identificadores que pertencem ao catálogo permitido pelo backend.
  conjuntoDadosVisiveis Json @default("[]") @map("conjunto_dados_visiveis")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  vinculos VinculoRedeApoio[]

  // Permite a chave estrangeira composta usada pelos vínculos da Rede de Apoio.
  @@unique([id, titularId])
  // Impede nomes repetidos para a mesma titular, inclusive em requisições simultâneas.
  @@unique([titularId, nomeNormalizado])
  @@map("categorias_permissao")
}

model VinculoRedeApoio {
  id Int @id @default(autoincrement())

  titularId Int     @map("titular_id")
  titular   Usuario @relation("VinculoTitular", fields: [titularId], references: [id], onDelete: Cascade)

  contatoId Int?     @map("contato_id")
  contato   Usuario? @relation("VinculoContato", fields: [contatoId], references: [id], onDelete: SetNull)

  emailConvidado String @map("email_convidado")

  categoriaId Int?                @map("categoria_id")
  categoria   CategoriaPermissao? @relation(fields: [categoriaId, titularId], references: [id, titularId], onDelete: Restrict)

  // O validator deve garantir um array de identificadores permitidos.
  permissoesIndividuais Json @default("[]") @map("permissoes_individuais")

  status StatusVinculoRedeApoio @default(pendente)

  tokenConviteHash String?   @unique @map("token_convite_hash")
  dataEnvio        DateTime  @default(now()) @map("data_envio")
  dataExpiracao    DateTime? @map("data_expiracao")
  dataResposta     DateTime? @map("data_resposta")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([titularId])
  @@index([contatoId])
  @@index([categoriaId, titularId])
  @@index([emailConvidado, status])
  @@map("vinculos_rede_apoio")
}

// ============================================================
// NOTIFICAÇÕES
// ============================================================

model PreferenciaNotificacao {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  cicloPrevisoesAtivo   Boolean @default(true) @map("ciclo_previsoes_ativo")
  anticoncepcionalAtivo Boolean @default(true) @map("anticoncepcional_ativo")
  redeApoioAtiva        Boolean @default(true) @map("rede_apoio_ativa")
  suporteTecnicoAtivo   Boolean @default(true) @map("suporte_tecnico_ativo")

  lembreteDiarioAtivo Boolean @default(true) @map("lembrete_diario_ativo")

  // O validator deve garantir rigorosamente o formato HH:mm.
  horarioLembreteDiario String @default("20:00") @map("horario_lembrete_diario")

  antecedenciaProximoCiclo Int @default(2) @map("antecedencia_proximo_ciclo")
  antecedenciaAvisoTroca   Int @default(7) @map("antecedencia_aviso_troca")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("preferencias_notificacao")
}

model Notificacao {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipoOrigem TipoOrigemNotificacao @map("tipo_origem")

  // Referência polimórfica: a integridade deve ser validada pelo service.
  origemId Int? @map("origem_id")

  dataHoraProgramada DateTime  @map("data_hora_programada")
  dataHoraDisparo    DateTime? @map("data_hora_disparo")

  intensidadeAlerta NivelIntensidadeAlerta? @map("intensidade_alerta")
  statusEnvio       StatusEnvioNotificacao  @default(agendada) @map("status_envio")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([usuarioId, statusEnvio])
  @@index([statusEnvio, dataHoraProgramada])
  @@map("notificacoes")
}

// ============================================================
// SUPORTE TÉCNICO
// ============================================================

model Conversa {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  mensagens Mensagem[]

  @@map("conversas_suporte")
}

model Mensagem {
  id         Int      @id @default(autoincrement())
  conversaId Int      @map("conversa_id")
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  remetente      RemetenteMensagem
  conteudo       String
  statusMensagem StatusMensagem    @default(enviando) @map("status_mensagem")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([conversaId, criadoEm])
  @@map("mensagens_suporte")
}
