{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "src/shared/http/server.js",
  "scripts": {
    "db:validate-migrations": "node scripts/validate-migrations.js",
    "dev": "node --watch src/shared/http/server.js",
    "format": "prettier --write \"**/*.{js,json,md,ts}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,ts}\"",
    "format:check:ci": "prettier --check eslint.config.js package.json \"scripts/**/*.js\" \"../.github/**/*.yml\" \"../docs/ci-cd.md\" \"../package.json\"",
    "lint": "eslint . --max-warnings=0",
    "start": "node src/shared/http/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=\"src/generated/**\" --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=93",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "10.0.10",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.3",
    "mysql2": "3.24.5",
    "qs": "6.16.0"
  }
}
